# These are placeholders. Never commit real credentials.
# Local defaults use H2; Supabase is optional until deployment.
# Copy the SESSION pooler host, port and username from Supabase -> Connect.
DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_INIT_MODE=never
REVIEWER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# .env is a reference, not loaded automatically by Spring Boot.
# Set these as environment variables in PowerShell or your hosting dashboard.
